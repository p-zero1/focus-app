<?xml version="1.0" encoding="utf-8"?>
<!--
  Focus App canonical logo mark — white F monogram.
  Source: design-system assets/logo.svg
  Canvas: 108×108dp (adaptive icon safe zone: inner 72×72, i.e. x/y 18–90)
  All F strokes sit well within the safe zone (leftmost x=36, rightmost x=72, top y=28, bottom y=80).

  F construction:
    · Vertical stem  — x 36–45, y 28–80  (w=9, h=52, rx=4.5 pill)
    · Top bar        — x 36–72, y 28–37  (w=36, h=9, rx=4.5 pill)
    · Middle bar     — x 36–62, y 50–59  (w=26, h=9, rx=4.5 pill)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Vertical stem: x=36 y=28 w=9 h=52 rx=4.5 (capsule — rx = w/2) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
          M 40.5,28
          A 4.5,4.5 0 0 1 45,32.5
          L 45,75.5
          A 4.5,4.5 0 0 1 40.5,80
          A 4.5,4.5 0 0 1 36,75.5
          L 36,32.5
          A 4.5,4.5 0 0 1 40.5,28 Z"/>

    <!-- Top bar: x=36 y=28 w=36 h=9 rx=4.5 (capsule — rx = h/2) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
          M 40.5,28
          L 67.5,28
          A 4.5,4.5 0 0 1 72,32.5
          A 4.5,4.5 0 0 1 67.5,37
          L 40.5,37
          A 4.5,4.5 0 0 1 36,32.5
          A 4.5,4.5 0 0 1 40.5,28 Z"/>

    <!-- Middle bar: x=36 y=50 w=26 h=9 rx=4.5 (capsule — rx = h/2) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
          M 40.5,50
          L 57.5,50
          A 4.5,4.5 0 0 1 62,54.5
          A 4.5,4.5 0 0 1 57.5,59
          L 40.5,59
          A 4.5,4.5 0 0 1 36,54.5
          A 4.5,4.5 0 0 1 40.5,50 Z"/>

</vector>
